# Managed by Ansible (monitoring/roles/monitoring). Edit group_vars and re-run instead.
global:
  scrape_interval: 30s
  evaluation_interval: 30s

alerting:
  alertmanagers:
    - static_configs:
        - targets: ["alertmanager:9093"]

rule_files:
  - /etc/prometheus/rules/*.yml

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ["localhost:9090"]

  - job_name: alertmanager
    static_configs:
      - targets: ["alertmanager:9093"]

  - job_name: node
    static_configs:
      - targets: ["{{ ansible_host }}:9100"]
        labels: { host: monitoring, env: prod }
{% for t in monitoring_node_targets %}
      - targets: ["{{ t.address }}"]
        labels: { host: {{ t.host }}, env: {{ t.env | default('prod') }} }
{% endfor %}

  # Proxmox node, VM and storage status from the Proxmox API.
  - job_name: proxmox
    metrics_path: /pve
    params:
      module: [default]
      cluster: ["1"]
      node: ["1"]
    static_configs:
      - targets: ["{{ monitoring_pve_host }}"]
        labels: { host: pve, env: prod }
    relabel_configs:
      - { source_labels: [__address__], target_label: __param_target }
      - { target_label: instance, replacement: pve }
      - { target_label: __address__, replacement: "pve-exporter:9221" }

  # Blackbox probes: Prometheus asks the exporter to probe each target, and the target
  # ends up as the instance label.
{% for job in [
    {'name': 'ping', 'module': 'icmp', 'targets': monitoring_ping_targets, 'key': 'address'},
    {'name': 'tcp', 'module': 'tcp_connect', 'targets': monitoring_tcp_targets, 'key': 'address'},
    {'name': 'http', 'module': 'http_2xx', 'targets': monitoring_http_targets, 'key': 'url'},
  ] if job.targets %}
  - job_name: {{ job.name }}
    metrics_path: /probe
    params:
      module: [{{ job.module }}]
    static_configs:
{% for t in job.targets %}
      - targets: ["{{ t[job.key] }}"]
        labels: { name: {{ t.name | default(t.host) }}, host: {{ t.host }}, env: {{ t.env | default('prod') }} }
{% endfor %}
    relabel_configs:
      - { source_labels: [__address__], target_label: __param_target }
      - { source_labels: [name], target_label: instance }
      - { target_label: __address__, replacement: "blackbox:9115" }

{% endfor %}
