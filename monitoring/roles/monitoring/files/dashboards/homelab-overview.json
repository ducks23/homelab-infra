    {
      "type": "bargauge",
      "title": "Memory given to running VMs, vs. the host's RAM",
      "id": 15,
      "description": "Over 100% means the VMs together could use more memory than the host has.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 12,
        "y": 30
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(pve_memory_size_bytes{id=~\"qemu/.+\"} and on (id) pve_up == 1) / on () sum(pve_memory_size_bytes{id=~\"node/.+\"})",
          "legendFormat": "running VMs",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1.5,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.9
              },
              {
                "color": "red",
                "value": 1.0
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
