# Managed by Ansible (ansible/monitoring/roles/monitoring). Edit group_vars and re-run instead.
global:
  smtp_smarthost: "{{ monitoring_smtp_host }}"
  smtp_from: "{{ monitoring_smtp_from }}"
  smtp_auth_username: "{{ monitoring_smtp_username }}"
  smtp_auth_password_file: /run/secrets/smtp_password
  smtp_require_tls: true

route:
  receiver: email
  # One email per alert per host; an outage that trips several alerts still sends several.
  group_by: [alertname, instance]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
  routes:
    # Always firing; its pings to Healthchecks.io prove the whole pipeline is alive.
    - matchers: ['alertname="Watchdog"']
      receiver: {{ 'healthchecks' if monitoring_healthchecks_url else 'blackhole' }}
      group_wait: 0s
      group_interval: 1m
      repeat_interval: 1m
    - matchers: ['env="dev"']
      receiver: email
      repeat_interval: 24h

# While a host doesn't answer ping, don't also email about each of its services.
inhibit_rules:
  - source_matchers: ['alertname="HostUnreachable"']
    target_matchers: ['alertname=~"ServiceDown|WebsiteDown"']
    equal: [host]

receivers:
  - name: email
    email_configs:
      - to: "{{ monitoring_alert_email }}"
        send_resolved: true
  - name: blackhole
{% if monitoring_healthchecks_url %}
  - name: healthchecks
    webhook_configs:
      - url_file: /run/secrets/healthchecks_url
        send_resolved: false
{% endif %}
